---
interface Props { num: string; title: string; caption: string; }
const { num, title, caption } = Astro.props;
---
<div class="slabel">
  <h2 class="slabel__title"><span class="slabel__num">{num}</span>{title}</h2>
  <p class="slabel__caption">{caption}</p>
</div>

<style>
  .slabel { display: flex; justify-content: space-between; gap: 40px; padding-top: 24px; }
  .slabel__title { display: flex; gap: 24px; font-size: var(--fs-meta); font-weight: 500; text-transform: uppercase; white-space: nowrap; }
  .slabel__num { color: var(--muted); }
  .slabel__caption { max-width: 820px; font-size: var(--fs-caption); line-height: 1.4; color: var(--muted); }
  @media (max-width: 700px) {
    .slabel { flex-direction: column; gap: 10px; padding-top: 16px; }
    .slabel__title { white-space: normal; }
  }
</style>
