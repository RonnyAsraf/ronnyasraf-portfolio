---
import { nav, site } from '../data/site';
---
<header class="nav wrap">
  <a class="nav__name" href="/">{site.name}</a>
  <nav class="nav__links" aria-label="Main">
    <ul>
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
  <a class="pill nav__cta" href={site.whatsapp} target="_blank" rel="noopener">Let's talk</a>
  <button class="nav__toggle" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
  <div class="nav__mobile" id="mobile-menu" hidden>
    <ul>
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href={site.whatsapp} target="_blank" rel="noopener">Let's talk</a></li>
    </ul>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.textContent = open ? 'Menu' : 'Close';
    if (menu) menu.hidden = open;
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => { if (menu) menu.hidden = true; btn?.setAttribute('aria-expanded', 'false'); if (btn) btn.textContent = 'Menu'; })
  );
</script>

<style>
  .nav {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 20px;
    font-size: var(--fs-nav);
  }
  .nav__name { font-weight: 500; text-transform: uppercase; }
  .nav__links ul { display: flex; gap: 40px; }
  .nav__links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .nav__cta { justify-self: end; text-transform: none; }
  .nav__toggle, .nav__mobile { display: none; }

  @media (max-width: 900px) {
    .nav { grid-template-columns: 1fr auto; padding-block: 14px; }
    .nav__links, .nav__cta { display: none; }
    .nav__toggle {
      display: block; justify-self: end; background: none; border: 0; padding: 6px 0;
      font-size: var(--fs-nav); text-transform: uppercase; cursor: pointer;
    }
    .nav__mobile:not([hidden]) {
      display: block; position: absolute; top: 100%; left: 0; right: 0; z-index: 50;
      background: var(--white); padding: 8px var(--pad) 24px; border-bottom: 1px solid var(--line);
    }
    .nav__mobile li a { display: block; padding: 12px 0; font-size: 20px; }
  }
</style>
