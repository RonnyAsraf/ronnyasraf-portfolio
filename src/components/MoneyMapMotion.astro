---
/**
 * Animated card preview for The Money Map, generated by scripts/money_map_motion.py from the Figma screens.
 * One phone, three scenes: the day-1 map builds and zooms into the task card, the daily video lesson
 * zooms into play, and the savings screen grows its bars. Transparent image layers, not video.
 */
---
<div class="motion motion--mm" aria-hidden="true">
  <div class="rig"><div class="dev">
      <div class="scene scene--1"><div class="cam cam--1">
        <img class="base" src="/images/case-studies/the-money-map/motion/a-base.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:11.256%;width:89.744%;height:2.607%;--i:0" src="/images/case-studies/the-money-map/motion/a-hi.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:14.573%;width:89.744%;height:34.360%;--i:1" src="/images/case-studies/the-money-map/motion/a-hero.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:49.882%;width:89.744%;height:8.057%;--i:2" src="/images/case-studies/the-money-map/motion/a-r1.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:58.886%;width:89.744%;height:8.057%;--i:3" src="/images/case-studies/the-money-map/motion/a-r2.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:67.891%;width:89.744%;height:8.057%;--i:4" src="/images/case-studies/the-money-map/motion/a-r3.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:76.896%;width:89.744%;height:7.583%;--i:5" src="/images/case-studies/the-money-map/motion/a-r4.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:84.597%;width:89.744%;height:7.820%;--i:6" src="/images/case-studies/the-money-map/motion/a-nav.webp" alt="" loading="lazy" decoding="async" />
      </div></div>
      <div class="scene scene--2"><div class="cam cam--2">
        <img class="base" src="/images/case-studies/the-money-map/motion/b-base.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-right s2" style="left:0.000%;top:11.019%;width:100.000%;height:4.976%;--i:0" src="/images/case-studies/the-money-map/motion/b-days.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:5.128%;top:17.654%;width:89.744%;height:5.450%;--i:1" src="/images/case-studies/the-money-map/motion/b-tabs.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:5.128%;top:25.000%;width:89.744%;height:59.597%;--i:2" src="/images/case-studies/the-money-map/motion/b-video.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:5.128%;top:84.597%;width:89.744%;height:7.820%;--i:3" src="/images/case-studies/the-money-map/motion/b-nav.webp" alt="" loading="lazy" decoding="async" />

        <span class="pulse"></span>
      </div></div>
      <div class="scene scene--3"><div class="cam cam--3">
        <img class="base" src="/images/case-studies/the-money-map/motion/c-base.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:4.615%;top:11.256%;width:90.256%;height:5.450%;--i:0" src="/images/case-studies/the-money-map/motion/c-tabs.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:11.795%;top:20.498%;width:76.410%;height:12.322%;--i:1" src="/images/case-studies/the-money-map/motion/c-total.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:11.795%;top:54.621%;width:15.897%;height:4.384%;--i:2" src="/images/case-studies/the-money-map/motion/c-b1.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:32.051%;top:52.725%;width:15.897%;height:6.280%;--i:3" src="/images/case-studies/the-money-map/motion/c-b2.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:52.308%;top:46.327%;width:15.897%;height:12.678%;--i:4" src="/images/case-studies/the-money-map/motion/c-b3.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:72.308%;top:35.545%;width:15.897%;height:23.460%;--i:5" src="/images/case-studies/the-money-map/motion/c-b4.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:47.692%;top:70.616%;width:47.179%;height:2.844%;--i:6" src="/images/case-studies/the-money-map/motion/c-h.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:5.641%;top:75.118%;width:88.718%;height:6.635%;--i:7" src="/images/case-studies/the-money-map/motion/c-l1.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:5.641%;top:82.701%;width:88.718%;height:6.635%;--i:8" src="/images/case-studies/the-money-map/motion/c-l2.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:5.641%;top:90.284%;width:88.718%;height:6.635%;--i:9" src="/images/case-studies/the-money-map/motion/c-l3.webp" alt="" loading="lazy" decoding="async" />
      </div></div>
  </div></div>
</div>

<style>
  .motion { position: absolute; inset: 0; container-type: inline-size; pointer-events: none; opacity: 0; transition: opacity .35s ease; }
  .rig { position: absolute; left: 35.5cqw; top: 2.9cqw; width: 29cqw; aspect-ratio: 390 / 844; }
  .dev {
    position: absolute; inset: 0;
    overflow: hidden; background: #f4f4f4; opacity: 0; border-radius: 4.2cqw;
    border: .45cqw solid rgba(255, 255, 255, .75); background-clip: padding-box;
    box-shadow: 2.1cqw 1.7cqw 4.7cqw rgba(112, 144, 176, .2);
  }
  .scene, .cam { position: absolute; inset: 0; }
  .scene { opacity: 0; }
  .base, .tile { position: absolute; display: block; }
  .base { inset: 0; width: 100%; height: 100%; }
  .tile { opacity: 0; }
  .pulse {
    position: absolute; left: 50%; top: 57.2%; width: 17%; aspect-ratio: 1; border-radius: 50%;
    border: .5cqw solid #fff; transform: translate(-50%, -50%) scale(.6); opacity: 0;
  }

  :global(.card.is-playing) .motion--mm { opacity: 1; }
  :global(.card.is-playing .card-static) { opacity: 0; }

  /* the phone rises in once and stays; scenes slide in from the side like app navigation */
  :global(.card.is-playing) .dev { animation: dev 14s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes dev { 0% { opacity: 0; transform: translateY(4cqw) scale(.96); } 4%, 97% { opacity: 1; transform: none; } 100% { opacity: 0; transform: scale(1.02); } }
  :global(.card.is-playing) .scene--1 { animation: sc1 14s cubic-bezier(.2,.7,.2,1) infinite; }
  :global(.card.is-playing) .scene--2 { animation: sc2 14s cubic-bezier(.2,.7,.2,1) infinite; }
  :global(.card.is-playing) .scene--3 { animation: sc3 14s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes sc1 { 0%, 31% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; transform: translateX(-8%); } }
  @keyframes sc2 { 0%, 31% { opacity: 0; transform: translateX(10%); } 34%, 64% { opacity: 1; transform: none; } 67%, 100% { opacity: 0; transform: translateX(-8%); } }
  @keyframes sc3 { 0%, 64% { opacity: 0; transform: translateX(10%); } 67%, 100% { opacity: 1; transform: none; } }

  /* builds: each scene's parts arrive one after another */
  :global(.card.is-playing) .s1 { animation: in1 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(.35s + var(--i) * .15s); }
  :global(.card.is-playing) .s2 { animation: in2 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .15s); }
  :global(.card.is-playing) .s3 { animation: in3 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .13s); }
  :global(.card.is-playing) .k-right { animation-name: in2r; }
  :global(.card.is-playing) .k-bar { transform-origin: 50% 100%; animation-name: in3b; }
  @keyframes in1  { 0% { opacity: 0; transform: translateY(16%) scale(.97); } 3%, 30% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; } }
  @keyframes in2  { 0%, 33% { opacity: 0; transform: translateY(16%) scale(.97); } 36%, 63% { opacity: 1; transform: none; } 67%, 100% { opacity: 0; } }
  @keyframes in2r { 0%, 33% { opacity: 0; transform: translateX(30%); } 37%, 63% { opacity: 1; transform: none; } 67%, 100% { opacity: 0; } }
  @keyframes in3  { 0%, 66% { opacity: 0; transform: translateY(16%) scale(.97); } 69%, 99% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes in3b { 0%, 68% { opacity: 0; transform: scaleY(0); } 69% { opacity: 1; transform: scaleY(0); } 73%, 99% { opacity: 1; transform: none; } 100% { opacity: 0; } }

  /* the whole phone, frame included, zooms: into the day-1 card, onto the play button, then onto the savings chart */
  :global(.card.is-playing) .rig { animation: zoom 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes zoom {
    0%, 17% { transform: none; transform-origin: 50% 32%; }
    23%, 29% { transform: scale(1.45); transform-origin: 50% 32%; }
    33%, 46% { transform: none; transform-origin: 50% 57%; }
    52%, 62% { transform: scale(1.6); transform-origin: 50% 57%; }
    66%, 82% { transform: none; transform-origin: 50% 40%; }
    88%, 97% { transform: scale(1.35); transform-origin: 50% 40%; }
    100% { transform: none; transform-origin: 50% 40%; }
  }
  :global(.card.is-playing) .pulse { animation: pulse 14s ease-out infinite; }
  @keyframes pulse { 0%, 53% { opacity: 0; transform: translate(-50%, -50%) scale(.6); } 54% { opacity: .9; } 60% { opacity: 0; transform: translate(-50%, -50%) scale(1.5); } 61%, 100% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) { .motion { display: none; } }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.card:has(.motion--mm)');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (matchMedia('(hover: hover)').matches) {
      cards.forEach((c) => {
        const on = () => c.classList.add('is-playing');
        const off = () => c.classList.remove('is-playing');
        c.addEventListener('mouseenter', on); c.addEventListener('mouseleave', off);
        c.addEventListener('focusin', on); c.addEventListener('focusout', off);
      });
    } else {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-playing', e.isIntersecting)), { threshold: 0.6 });
      cards.forEach((c) => io.observe(c));
    }
  }
</script>
