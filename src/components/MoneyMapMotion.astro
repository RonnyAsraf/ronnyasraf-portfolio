---
/**
 * Animated card preview for The Money Map, generated by scripts/money_map_motion.py from the Figma screens.
 * One phone, one screen: the day-1 map builds and the phone zooms into the task card. Transparent image layers, not video.
 */
---
<div class="motion motion--mm" aria-hidden="true">
  <div class="rig"><div class="dev">
      <div class="scene scene--1"><div class="cam cam--1">
        <img class="base" src="/images/case-studies/the-money-map/motion/a-base.webp?v=5ec63eae" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:11.256%;width:89.744%;height:2.607%;--i:0" src="/images/case-studies/the-money-map/motion/a-hi.webp?v=5ec63eae" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:14.573%;width:89.744%;height:34.360%;--i:1" src="/images/case-studies/the-money-map/motion/a-hero.webp?v=5ec63eae" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:49.882%;width:89.744%;height:8.057%;--i:2" src="/images/case-studies/the-money-map/motion/a-r1.webp?v=5ec63eae" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:58.886%;width:89.744%;height:8.057%;--i:3" src="/images/case-studies/the-money-map/motion/a-r2.webp?v=5ec63eae" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:67.891%;width:89.744%;height:8.057%;--i:4" src="/images/case-studies/the-money-map/motion/a-r3.webp?v=5ec63eae" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:76.896%;width:89.744%;height:7.583%;--i:5" src="/images/case-studies/the-money-map/motion/a-r4.webp?v=5ec63eae" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:5.128%;top:84.597%;width:89.744%;height:7.820%;--i:6" src="/images/case-studies/the-money-map/motion/a-nav.webp?v=5ec63eae" alt="" loading="lazy" decoding="async" />
      </div></div>
  </div></div>
</div>

<style>
  .motion { position: absolute; inset: 0; container-type: inline-size; pointer-events: none; opacity: 0; transition: opacity .35s ease; }
  .rig { position: absolute; left: 35.5cqw; top: 2.9cqw; width: 29cqw; aspect-ratio: 390 / 844; }
  .dev {
    position: absolute; inset: 0;
    overflow: hidden; background: #f4f4f4; opacity: 0; border-radius: 4.2cqw;
    border: .45cqw solid rgba(255, 255, 255, .75); background-clip: padding-box;
    box-shadow: 2.1cqw 1.7cqw 4.7cqw rgba(112, 144, 176, .2);
  }
  .scene, .cam { position: absolute; inset: 0; }
  .scene { opacity: 0; }
  .base, .tile { position: absolute; display: block; }
  .base { inset: 0; width: 100%; height: 100%; }
  .tile { opacity: 0; }

  :global(.card.is-playing) .motion--mm { opacity: 1; }
  :global(.card.is-playing .card-static) { opacity: 0; }

  /* one screen: the phone rises in, the day-1 map builds, then the phone (frame included) zooms into the day-1 card */
  :global(.card.is-playing) .dev { animation: mm-dev 6s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes mm-dev { 0% { opacity: 0; transform: translateY(4cqw) scale(.96); } 7%, 94% { opacity: 1; transform: none; } 100% { opacity: 0; transform: scale(1.02); } }
  .scene--1 { opacity: 1; }
  :global(.card.is-playing) .s1 { animation: mm-in1 6s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(.35s + var(--i) * .15s); }
  @keyframes mm-in1 { 0% { opacity: 0; transform: translateY(16%) scale(.97); } 6%, 93% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  :global(.card.is-playing) .rig { transform-origin: 50% 32%; animation: mm-zoom 6s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes mm-zoom { 0%, 40% { transform: none; } 55%, 88% { transform: scale(1.45); } 100% { transform: none; } }

  @media (prefers-reduced-motion: reduce) { .motion { display: none; } }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.card:has(.motion--mm)');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (matchMedia('(hover: hover)').matches) {
      cards.forEach((c) => {
        const on = () => c.classList.add('is-playing');
        const off = () => c.classList.remove('is-playing');
        c.addEventListener('mouseenter', on); c.addEventListener('mouseleave', off);
        c.addEventListener('focusin', on); c.addEventListener('focusout', off);
      });
    } else {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-playing', e.isIntersecting)), { threshold: 0.6 });
      cards.forEach((c) => io.observe(c));
    }
  }
</script>
