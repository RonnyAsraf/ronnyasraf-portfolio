---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer dark wrap">
  <div class="footer__top">
    <p class="footer__name">{site.name}</p>
    <div class="footer__cols">
      <ul>
        <li><a href="/">Home page</a></li>
        <li><a href="/#case-studies">Projects</a></li>
        <li><a href="/websites">Websites</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href="/#services">My services</a></li>
      </ul>
      <ul>
        <li><a href={site.whatsapp} target="_blank" rel="noopener">{site.phoneIL}</a></li>
        <li><a href={site.phoneITLink} target="_blank" rel="noopener">{site.phoneIT}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.linkedin && <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>}
        <li>{site.location}</li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <p>© {year} All rights reserved to {site.name}</p>
    <ul>
      <li><a href="/privacy-policy">Privacy policy</a></li>
      <li><a href="/accessibility-statement">Accessibility statement</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink); color: var(--white);
    padding-top: clamp(64px, 50px + 3.6vw, 120px); padding-bottom: 40px;
    font-size: var(--fs-meta); font-weight: 500; text-transform: uppercase; line-height: 2;
  }
  .footer__top { display: flex; justify-content: space-between; gap: 40px; padding-bottom: 64px; }
  .footer__name { font-size: var(--fs-label); }
  .footer__cols { display: grid; grid-template-columns: repeat(2, minmax(200px, 300px)); gap: 40px; }
  .footer__cols a:hover, .footer__bottom a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .footer__cols a[href^='mailto'] { text-transform: none; }
  .footer__bottom {
    display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    border-top: 1px solid rgba(255, 255, 255, .25); padding-top: 24px;
  }
  .footer__bottom ul { display: flex; gap: 40px; }
  @media (max-width: 700px) {
    .footer__top { flex-direction: column; }
    .footer__cols { grid-template-columns: 1fr 1fr; gap: 24px; }
    .footer__bottom ul { gap: 20px; }
  }
</style>
