---
/**
 * Animated card preview for Timelines, generated by scripts/timelines_motion.py from the Figma screens.
 * One phone, three scenes: the albums list fills in and a tap opens an album, the album builds while the
 * timeline knob slides and a tag is tapped, then the photo picker for the printed album fills in.
 * The whole phone (frame included) zooms on each scene. Transparent image layers, not video.
 */
---
<div class="motion motion--tl" aria-hidden="true">
  <div class="rig"><div class="dev">
      <div class="scene scene--1">
        <img class="base" src="/images/case-studies/timelines/motion/a-base.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:0.000%;top:12.959%;width:100.000%;height:9.287%;--i:0" src="/images/case-studies/timelines/motion/a-r0.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:0.000%;top:22.786%;width:100.000%;height:9.287%;--i:1" src="/images/case-studies/timelines/motion/a-r1.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:0.000%;top:32.505%;width:100.000%;height:9.287%;--i:2" src="/images/case-studies/timelines/motion/a-r2.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:0.000%;top:42.333%;width:100.000%;height:9.287%;--i:3" src="/images/case-studies/timelines/motion/a-r3.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:0.000%;top:52.160%;width:100.000%;height:9.287%;--i:4" src="/images/case-studies/timelines/motion/a-r4.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:0.000%;top:61.987%;width:100.000%;height:9.287%;--i:5" src="/images/case-studies/timelines/motion/a-r5.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:0.000%;top:71.706%;width:100.000%;height:9.287%;--i:6" src="/images/case-studies/timelines/motion/a-r6.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-pop s1" style="left:72.897%;top:87.041%;width:17.757%;height:8.207%;--i:7" src="/images/case-studies/timelines/motion/a-fab.webp" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="scene scene--2">
        <img class="base" src="/images/case-studies/timelines/motion/b-base.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:0.000%;top:10.367%;width:100.000%;height:27.646%;--i:0" src="/images/case-studies/timelines/motion/b-hero.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-knob s2" style="left:38.785%;top:40.065%;width:5.607%;height:2.592%;--i:1" src="/images/case-studies/timelines/motion/b-knob.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:9.346%;top:47.084%;width:84.112%;height:7.775%;--i:2" src="/images/case-studies/timelines/motion/b-tags.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:32.710%;top:57.019%;width:35.047%;height:3.672%;--i:3" src="/images/case-studies/timelines/motion/b-month.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:6.075%;top:61.771%;width:87.850%;height:38.229%;--i:4" src="/images/case-studies/timelines/motion/b-post.webp" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="scene scene--3">
        <img class="base" src="/images/case-studies/timelines/motion/c-base.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:7.009%;top:12.095%;width:85.981%;height:6.048%;--i:0" src="/images/case-studies/timelines/motion/c-pick.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:35.047%;top:19.222%;width:58.879%;height:3.024%;--i:1" src="/images/case-studies/timelines/motion/c-auto.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:7.009%;top:24.406%;width:85.981%;height:19.654%;--i:2" src="/images/case-studies/timelines/motion/c-p1.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:7.009%;top:45.356%;width:85.981%;height:24.838%;--i:3" src="/images/case-studies/timelines/motion/c-p2.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:7.009%;top:71.490%;width:85.981%;height:13.391%;--i:4" src="/images/case-studies/timelines/motion/c-p3.webp" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s3" style="left:0.000%;top:85.313%;width:100.000%;height:14.687%;--i:5" src="/images/case-studies/timelines/motion/c-foot.webp" alt="" loading="lazy" decoding="async" />
      </div>
    <span class="tap tap--1"></span>
    <span class="tap tap--2"></span>
  </div></div>
</div>

<style>
  .motion { position: absolute; inset: 0; container-type: inline-size; pointer-events: none; opacity: 0; transition: opacity .35s ease; }
  .rig { position: absolute; left: 35.6cqw; top: 2.9cqw; width: 28.8cqw; aspect-ratio: 428 / 926; }
  .dev {
    position: absolute; inset: 0; overflow: hidden; background: #f7f7f7; opacity: 0; border-radius: 4.2cqw;
    border: .45cqw solid rgba(255, 255, 255, .75); background-clip: padding-box;
    box-shadow: 2.1cqw 1.7cqw 4.7cqw rgba(112, 144, 176, .2);
  }
  .scene { position: absolute; inset: 0; opacity: 0; }
  .base, .tile { position: absolute; display: block; }
  .base { inset: 0; width: 100%; height: 100%; }
  .tile { opacity: 0; }
  .tap { position: absolute; width: 5cqw; aspect-ratio: 1; border-radius: 50%; background: rgba(0, 186, 204, .35); border: .25cqw solid rgba(255,255,255,.9); transform: translate(-50%, -50%) scale(0); opacity: 0; }
  .tap--1 { left: 55%; top: 17.6%; }
  .tap--2 { left: 75%; top: 49.3%; }

  :global(.card.is-playing) .motion--tl { opacity: 1; }
  :global(.card.is-playing .card-static) { opacity: 0; }

  :global(.card.is-playing) .dev { animation: dev 14s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes dev { 0% { opacity: 0; transform: translateY(4cqw) scale(.96); } 4%, 97% { opacity: 1; transform: none; } 100% { opacity: 0; transform: scale(1.02); } }

  /* screens slide in like app navigation */
  :global(.card.is-playing) .scene--1 { animation: sc1 14s cubic-bezier(.2,.7,.2,1) infinite; }
  :global(.card.is-playing) .scene--2 { animation: sc2 14s cubic-bezier(.2,.7,.2,1) infinite; }
  :global(.card.is-playing) .scene--3 { animation: sc3 14s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes sc1 { 0%, 31% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; transform: translateX(-8%); } }
  @keyframes sc2 { 0%, 31% { opacity: 0; transform: translateX(10%); } 34%, 64% { opacity: 1; transform: none; } 67%, 100% { opacity: 0; transform: translateX(-8%); } }
  @keyframes sc3 { 0%, 64% { opacity: 0; transform: translateX(10%); } 67%, 100% { opacity: 1; transform: none; } }

  /* builds */
  :global(.card.is-playing) .s1 { animation: in1 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(.35s + var(--i) * .13s); }
  :global(.card.is-playing) .s2 { animation: in2 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .15s); }
  :global(.card.is-playing) .s3 { animation: in3 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .13s); }
  :global(.card.is-playing) .k-pop { animation-name: pop1; }
  :global(.card.is-playing) .k-knob { animation-name: knob; animation-delay: 0s; }
  @keyframes in1  { 0% { opacity: 0; transform: translateX(10%); } 3%, 31% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; } }
  @keyframes pop1 { 0%, 6% { opacity: 0; transform: scale(.4); } 9%, 31% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; } }
  @keyframes in2  { 0%, 33% { opacity: 0; transform: translateY(14%) scale(.97); } 36%, 64% { opacity: 1; transform: none; } 67%, 100% { opacity: 0; } }
  @keyframes knob { 0%, 37% { opacity: 0; transform: translateX(-330%); } 39% { opacity: 1; transform: translateX(-330%); } 47%, 64% { opacity: 1; transform: none; } 67%, 100% { opacity: 0; } }
  @keyframes in3  { 0%, 66% { opacity: 0; transform: translateY(14%) scale(.97); } 69%, 99% { opacity: 1; transform: none; } 100% { opacity: 0; } }

  /* taps: open the first album, then pick the trips tag */
  :global(.card.is-playing) .tap--1 { animation: tap1 14s ease-out infinite; }
  :global(.card.is-playing) .tap--2 { animation: tap2 14s ease-out infinite; }
  @keyframes tap1 { 0%, 27% { opacity: 0; transform: translate(-50%, -50%) scale(.3); } 28% { opacity: 1; transform: translate(-50%, -50%) scale(.7); } 32%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.4); } }
  @keyframes tap2 { 0%, 57% { opacity: 0; transform: translate(-50%, -50%) scale(.3); } 58% { opacity: 1; transform: translate(-50%, -50%) scale(.7); } 62%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.4); } }

  /* the whole phone, frame included, zooms on each screen */
  :global(.card.is-playing) .rig { animation: zoom 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes zoom {
    0%, 15% { transform: none; transform-origin: 50% 25%; }
    21%, 30% { transform: scale(1.4); transform-origin: 50% 25%; }
    34%, 45% { transform: none; transform-origin: 50% 42%; }
    51%, 62% { transform: scale(1.5); transform-origin: 50% 42%; }
    67%, 80% { transform: none; transform-origin: 50% 40%; }
    86%, 97% { transform: scale(1.35); transform-origin: 50% 40%; }
    100% { transform: none; transform-origin: 50% 40%; }
  }

  @media (prefers-reduced-motion: reduce) { .motion { display: none; } }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.card:has(.motion--tl)');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (matchMedia('(hover: hover)').matches) {
      cards.forEach((c) => {
        const on = () => c.classList.add('is-playing');
        const off = () => c.classList.remove('is-playing');
        c.addEventListener('mouseenter', on); c.addEventListener('mouseleave', off);
        c.addEventListener('focusin', on); c.addEventListener('focusout', off);
      });
    } else {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-playing', e.isIntersecting)), { threshold: 0.6 });
      cards.forEach((c) => io.observe(c));
    }
  }
</script>
