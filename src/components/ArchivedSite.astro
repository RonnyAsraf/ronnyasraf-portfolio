---
/** Page for a website that is no longer live in this design: hero + the full screen recording, large. */
import Base from '../layouts/Base.astro';
import CaseHero from './CaseHero.astro';
import OtherProjects from './OtherProjects.astro';
import type { Site } from '../data/projects';

interface Props { site: Site }
const { site } = Astro.props;
const [kind, platform] = site.type.split(', ');
const summary = site.summary ?? `${kind} design and development.`;
const src = `/videos/websites/${site.slug}`;
---
<Base title={site.name} description={summary}>
  <CaseHero title={site.name.toLowerCase()} credits={[`${kind}\n${site.year}`, `Design & development\n${platform ?? ''}`]} summary={summary} />
  <div class="wrap vid">
    <div class="browser">
      <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <video src={`${src}.mp4`} poster={`${src}.webp`} autoplay muted loop playsinline preload="metadata" aria-label={`Screen recording of the ${site.name} website`}></video>
    </div>
    <p class="note">Screen recording of the site as launched. The live site has since changed.</p>
  </div>
  <OtherProjects kind="websites" current={site.slug} />
</Base>

<style>
  .vid { padding-bottom: var(--gap-section); }
  .browser { border-radius: var(--radius-panel); overflow: hidden; background: var(--panel); box-shadow: 0 20px 60px rgba(112, 144, 176, .18); }
  .browser__bar { height: clamp(22px, 14px + 1.2vw, 36px); background: #f4f4f4; display: flex; align-items: center; gap: 7px; padding-left: clamp(12px, 8px + 1vw, 22px); }
  .browser__bar i { width: 9px; height: 9px; border-radius: 50%; background: #d9d9d9; }
  .browser video { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; object-position: top; background: #fff; }
  .note { margin-top: 16px; font-size: var(--fs-meta); opacity: .6; }
  @media (prefers-reduced-motion: reduce) { .browser video { animation: none; } }
</style>
