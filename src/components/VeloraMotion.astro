---
/**
 * Animated card preview for Velora, generated by scripts/velora_motion.py from the Figma screens.
 * A product walkthrough: the window arrives tilted in 3D and settles, the dashboard builds, a cursor
 * opens a client, switches to the scenario comparison tab, the chart grows and the window zooms into it.
 * Transparent image layers (not video) so the card's hover colour shows through.
 */
---
<div class="motion motion--velora" aria-hidden="true">
  <div class="rig"><div class="dev">
      <div class="scene scene--1">
        <img class="base" src="/images/case-studies/velora/motion/a-base.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:61.944%;top:9.375%;width:27.639%;height:9.961%;--i:0" src="/images/case-studies/velora/motion/a-k0.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:32.917%;top:9.375%;width:27.639%;height:9.961%;--i:1" src="/images/case-studies/velora/motion/a-k1.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:3.889%;top:9.375%;width:27.639%;height:9.961%;--i:2" src="/images/case-studies/velora/motion/a-k2.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:48.958%;top:31.055%;width:40.278%;height:9.180%;--i:3" src="/images/case-studies/velora/motion/a-m1.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:48.958%;top:41.016%;width:40.278%;height:9.180%;--i:4" src="/images/case-studies/velora/motion/a-m2.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:3.889%;top:31.348%;width:40.625%;height:11.914%;--i:5" src="/images/case-studies/velora/motion/a-t0.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:3.889%;top:44.043%;width:40.625%;height:11.914%;--i:6" src="/images/case-studies/velora/motion/a-t1.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:3.889%;top:56.738%;width:40.625%;height:11.914%;--i:7" src="/images/case-studies/velora/motion/a-t2.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:3.889%;top:69.434%;width:40.625%;height:11.914%;--i:8" src="/images/case-studies/velora/motion/a-t3.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s1" style="left:3.889%;top:82.129%;width:40.625%;height:11.914%;--i:9" src="/images/case-studies/velora/motion/a-t4.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="scene scene--2">
        <img class="base" src="/images/case-studies/velora/motion/b-base.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:47.500%;top:26.367%;width:42.083%;height:10.742%;--i:0" src="/images/case-studies/velora/motion/b-s1.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:3.889%;top:26.367%;width:42.083%;height:10.742%;--i:1" src="/images/case-studies/velora/motion/b-s2.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:47.361%;top:38.867%;width:42.222%;height:26.172%;--i:2" src="/images/case-studies/velora/motion/b-inc.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:3.889%;top:38.867%;width:42.222%;height:26.172%;--i:3" src="/images/case-studies/velora/motion/b-don.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-up s2" style="left:3.889%;top:66.797%;width:85.694%;height:31.445%;--i:4" src="/images/case-studies/velora/motion/b-goals.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="scene scene--3">
        <img class="base" src="/images/case-studies/velora/motion/c-base.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:73.611%;top:58.594%;width:8.472%;height:26.562%;--i:0" src="/images/case-studies/velora/motion/c-b0.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:57.639%;top:58.594%;width:8.472%;height:26.562%;--i:1" src="/images/case-studies/velora/motion/c-b1.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:41.667%;top:58.594%;width:8.472%;height:26.562%;--i:2" src="/images/case-studies/velora/motion/c-b2.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:25.694%;top:58.594%;width:8.472%;height:26.562%;--i:3" src="/images/case-studies/velora/motion/c-b3.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
        <img class="tile k-bar s3" style="left:9.722%;top:58.594%;width:8.472%;height:26.562%;--i:4" src="/images/case-studies/velora/motion/c-b4.webp?v=af39558a" alt="" loading="lazy" decoding="async" />
      </div>
    <span class="ripple ripple--1"></span>
    <span class="ripple ripple--2"></span>
    <svg class="cursor" viewBox="0 0 24 24"><path d="M5 3l14 8-6.2 1.6L9.6 19z" fill="#0e0e0e" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/></svg>
  </div></div>
</div>

<style>
  .motion { position: absolute; inset: 0; container-type: inline-size; pointer-events: none; opacity: 0; transition: opacity .35s ease; }
  .rig { position: absolute; left: 8cqw; top: 4.4cqw; width: 84cqw; aspect-ratio: 1440 / 1024; }
  .dev {
    position: absolute; inset: 0; overflow: hidden; background: #fafafa; opacity: 0; border-radius: 1.3cqw;
    border: .45cqw solid rgba(255, 255, 255, .75); background-clip: padding-box;
    box-shadow: 2.1cqw 1.7cqw 4.7cqw rgba(112, 144, 176, .2);
  }
  .scene { position: absolute; inset: 0; opacity: 0; }
  .base, .tile { position: absolute; display: block; }
  .base { inset: 0; width: 100%; height: 100%; }
  .tile { opacity: 0; }
  .cursor { position: absolute; width: 2.4cqw; height: 2.4cqw; left: 60%; top: 62%; opacity: 0; filter: drop-shadow(0 .2cqw .4cqw rgba(0,0,0,.25)); }
  .ripple { position: absolute; width: 4cqw; aspect-ratio: 1; border-radius: 50%; background: rgba(14, 14, 14, .18); transform: translate(-50%, -50%) scale(0); opacity: 0; }
  .ripple--1 { left: 97%; top: 20.6%; }
  .ripple--2 { left: 77.6%; top: 22.8%; }

  :global(.card.is-playing) .motion--velora { opacity: 1; }
  :global(.card.is-playing .card-static) { opacity: 0; }

  /* window: arrives tilted in 3D and settles flat, later zooms (frame included) into the chart */
  :global(.card.is-playing) .rig { animation: rig 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes rig {
    0% { transform: perspective(110cqw) rotateX(24deg) rotateY(-10deg) rotateZ(6deg) scale(.82); transform-origin: 50% 50%; }
    11%, 72% { transform: none; transform-origin: 50% 50%; }
    73% { transform: none; transform-origin: 58% 72%; }
    81%, 92% { transform: scale(1.65); transform-origin: 58% 72%; }
    98%, 100% { transform: none; transform-origin: 58% 72%; }
  }
  :global(.card.is-playing) .dev { animation: dev 14s ease infinite; }
  @keyframes dev { 0% { opacity: 0; } 5%, 96% { opacity: 1; } 100% { opacity: 0; } }

  /* pages: dashboard, then client overview, then the scenario comparison tab */
  :global(.card.is-playing) .scene--1 { animation: sc1 14s ease infinite; }
  :global(.card.is-playing) .scene--2 { animation: sc2 14s ease infinite; }
  :global(.card.is-playing) .scene--3 { animation: sc3 14s ease infinite; }
  @keyframes sc1 { 0%, 26% { opacity: 1; } 29%, 100% { opacity: 0; } }
  @keyframes sc2 { 0%, 26% { opacity: 0; transform: translateY(1.5%); } 29%, 50% { opacity: 1; transform: none; } 53%, 100% { opacity: 0; } }
  @keyframes sc3 { 0%, 50% { opacity: 0; } 53%, 100% { opacity: 1; } }

  /* parts build in each page */
  :global(.card.is-playing) .s1 { animation: in1 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(.6s + var(--i) * .12s); }
  :global(.card.is-playing) .s2 { animation: in2 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .13s); }
  :global(.card.is-playing) .s3 { animation: in3 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .14s); }
  @keyframes in1 { 0% { opacity: 0; transform: translateY(18%) scale(.97); } 4%, 26% { opacity: 1; transform: none; } 30%, 100% { opacity: 0; } }
  @keyframes in2 { 0%, 28% { opacity: 0; transform: translateY(14%) scale(.98); } 32%, 50% { opacity: 1; transform: none; } 54%, 100% { opacity: 0; } }
  @keyframes in3 { 0%, 54% { opacity: 1; clip-path: inset(100% 0 0 0); } 61%, 99% { opacity: 1; clip-path: inset(0 0 0 0); } 100% { opacity: 0; } }

  /* cursor: to the clients icon (click), to the financial efficiency tab (click), then hovers the 10-year bars */
  :global(.card.is-playing) .cursor { animation: cur 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes cur {
    0%, 9% { opacity: 0; left: 62%; top: 64%; transform: none; }
    12% { opacity: 1; left: 62%; top: 64%; }
    22% { left: 96.2%; top: 19.4%; transform: none; }
    23.5% { transform: scale(.82); } 25% { transform: none; }
    34% { left: 88%; top: 48%; }
    45% { left: 76.9%; top: 21.6%; transform: none; }
    46.5% { transform: scale(.82); } 48% { transform: none; }
    58% { left: 70%; top: 50%; }
    70%, 94% { opacity: 1; left: 59.4%; top: 60.6%; }
    97%, 100% { opacity: 0; left: 59.4%; top: 60.6%; }
  }
  :global(.card.is-playing) .ripple--1 { animation: rip1 14s ease-out infinite; }
  :global(.card.is-playing) .ripple--2 { animation: rip2 14s ease-out infinite; }
  @keyframes rip1 { 0%, 23% { opacity: 0; transform: translate(-50%, -50%) scale(0); } 23.5% { opacity: 1; } 28%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.4); } }
  @keyframes rip2 { 0%, 46% { opacity: 0; transform: translate(-50%, -50%) scale(0); } 46.5% { opacity: 1; } 51%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.4); } }

  @media (prefers-reduced-motion: reduce) { .motion { display: none; } }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.card:has(.motion--velora)');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (matchMedia('(hover: hover)').matches) {
      cards.forEach((c) => {
        const on = () => c.classList.add('is-playing');
        const off = () => c.classList.remove('is-playing');
        c.addEventListener('mouseenter', on); c.addEventListener('mouseleave', off);
        c.addEventListener('focusin', on); c.addEventListener('focusout', off);
      });
    } else {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-playing', e.isIntersecting)), { threshold: 0.6 });
      cards.forEach((c) => io.observe(c));
    }
  }
</script>
