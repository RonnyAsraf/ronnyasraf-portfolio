---
/**
 * Animated card preview for Cover, generated by gen/cover_motion.py from the Figma screens.
 * Three scenes, one device at a time: the dashboard builds itself and zooms into the AI card,
 * the tablet zooms into the order as dishes are added, the phone fills its table list and shows the swipe.
 * Built from transparent image layers (not video) so the card's hover colour shows through.
 */
---
<div class="motion motion--cover" aria-hidden="true">
  <div class="rig rig--desktop"><div class="dev dev--desktop">
    <div class="cam">
      <img class="base" src="/images/case-studies/cover/motion/d-base.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:85.417%;top:0.000%;width:14.583%;height:100.000%;--i:0" src="/images/case-studies/cover/motion/d-side.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:2.083%;top:10.370%;width:81.250%;height:6.111%;--i:1" src="/images/case-studies/cover/motion/d-head.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:56.823%;top:17.685%;width:26.510%;height:10.278%;--i:2" src="/images/case-studies/cover/motion/d-k1.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:29.427%;top:17.685%;width:26.510%;height:10.278%;--i:3" src="/images/case-studies/cover/motion/d-k2.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:2.083%;top:17.685%;width:26.510%;height:10.278%;--i:4" src="/images/case-studies/cover/motion/d-k3.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:43.125%;top:30.185%;width:40.208%;height:32.593%;--i:5" src="/images/case-studies/cover/motion/d-ai.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:2.083%;top:30.185%;width:40.208%;height:46.574%;--i:6" src="/images/case-studies/cover/motion/d-pop.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:43.125%;top:64.259%;width:40.208%;height:12.500%;--i:7" src="/images/case-studies/cover/motion/d-st.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:56.823%;top:79.074%;width:26.510%;height:17.593%;--i:8" src="/images/case-studies/cover/motion/d-c1.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:29.427%;top:79.074%;width:26.510%;height:17.593%;--i:9" src="/images/case-studies/cover/motion/d-c2.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:2.083%;top:79.074%;width:26.510%;height:17.593%;--i:10" src="/images/case-studies/cover/motion/d-c3.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
    </div>
  </div></div>
  <div class="rig rig--tablet"><div class="dev dev--tablet">
    <div class="cam">
      <img class="base" src="/images/case-studies/cover/motion/t-base.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:3.837%;top:29.732%;width:40.528%;height:12.563%;--i:0" src="/images/case-studies/cover/motion/t-i0.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:3.837%;top:42.965%;width:40.528%;height:12.563%;--i:1" src="/images/case-studies/cover/motion/t-i1.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:3.837%;top:56.198%;width:40.528%;height:12.563%;--i:2" src="/images/case-studies/cover/motion/t-i2.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:3.837%;top:69.430%;width:40.528%;height:12.563%;--i:3" src="/images/case-studies/cover/motion/t-i3.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:3.837%;top:82.663%;width:40.528%;height:12.563%;--i:4" src="/images/case-studies/cover/motion/t-i4.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
    </div>
  </div></div>
  <div class="rig rig--phone"><div class="dev dev--phone">
    <div class="cam">
      <img class="base" src="/images/case-studies/cover/motion/p-base.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:20.261%;width:89.744%;height:8.412%;--i:0" src="/images/case-studies/cover/motion/p-r0.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:29.621%;width:89.744%;height:8.412%;--i:1" src="/images/case-studies/cover/motion/p-r1.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:38.981%;width:89.744%;height:8.412%;--i:2" src="/images/case-studies/cover/motion/p-r2.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:48.341%;width:89.744%;height:8.412%;--i:3" src="/images/case-studies/cover/motion/p-r3.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:57.701%;width:89.744%;height:8.412%;--i:4" src="/images/case-studies/cover/motion/p-r4.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:67.062%;width:89.744%;height:8.412%;--i:5" src="/images/case-studies/cover/motion/p-r5.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:76.422%;width:89.744%;height:8.412%;--i:6" src="/images/case-studies/cover/motion/p-r6.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:85.782%;width:89.744%;height:8.412%;--i:7" src="/images/case-studies/cover/motion/p-r7.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:95.142%;width:89.744%;height:8.412%;--i:8" src="/images/case-studies/cover/motion/p-r8.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
      <img class="tile swipe" style="left:0%;top:19.550%;width:100%;height:17.180%" src="/images/case-studies/cover/motion/p-swipe.webp?v=ca5bad93" alt="" loading="lazy" decoding="async" />
    </div>
  </div></div>
</div>

<style>
  /* Sizes in cqw (percent of the card width) so the scene scales with the card. Card is 905:620 = 100cqw x 68.5cqw. */
  .motion { position: absolute; inset: 0; container-type: inline-size; pointer-events: none; opacity: 0; transition: opacity .35s ease; }
  .rig { position: absolute; }
  .dev {
    position: absolute; inset: 0; overflow: hidden; background: #fff; opacity: 0;
    border: .45cqw solid rgba(255, 255, 255, .75); background-clip: padding-box;
    box-shadow: 2.1cqw 1.7cqw 4.7cqw rgba(112, 144, 176, .2);
  }
  .rig--desktop { left: 8cqw; top: 10.6cqw; width: 84cqw; aspect-ratio: 16 / 9; } .dev--desktop { border-radius: 1.3cqw; }
  .rig--tablet { left: 29.75cqw; top: 5cqw; width: 40.5cqw; aspect-ratio: 834 / 1194; } .dev--tablet { border-radius: 2.6cqw; }
  .rig--phone { left: 36.1cqw; top: 4.2cqw; width: 27.8cqw; aspect-ratio: 390 / 844; } .dev--phone { border-radius: 4cqw; }
  .cam { position: absolute; inset: 0; }
  .base, .tile { position: absolute; display: block; }
  .base { inset: 0; width: 100%; height: 100%; }
  .tile { opacity: 0; }

  :global(.card.is-playing) .motion { opacity: 1; }
  :global(.card.is-playing .card-static) { opacity: 0; }

  /* ---- scene timing (14s loop): desktop 0-33%, tablet 33-66%, phone 66-100% ---- */
  :global(.card.is-playing) .dev--desktop { animation: sc-d 14s cubic-bezier(.2,.7,.2,1) infinite; }
  :global(.card.is-playing) .dev--tablet  { animation: sc-t 14s cubic-bezier(.2,.7,.2,1) infinite; }
  :global(.card.is-playing) .dev--phone   { animation: sc-p 14s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes sc-d { 0% { opacity: 0; transform: translateY(3cqw) scale(.96); } 4%, 30% { opacity: 1; transform: none; } 33%, 100% { opacity: 0; transform: scale(1.02); } }
  @keyframes sc-t { 0%, 33% { opacity: 0; transform: translateY(4cqw) scale(.96); } 37%, 63% { opacity: 1; transform: none; } 66%, 100% { opacity: 0; transform: scale(1.02); } }
  @keyframes sc-p { 0%, 66% { opacity: 0; transform: translateY(4cqw) scale(.96); } 70%, 97% { opacity: 1; transform: none; } 100% { opacity: 0; transform: scale(1.02); } }

  /* desktop: parts pop in one by one, then the whole device (frame included) zooms into the AI recommendations card */
  :global(.card.is-playing) .td { animation: build-d 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(.35s + var(--i) * .16s); }
  @keyframes build-d { 0% { opacity: 0; transform: translateY(14%) scale(.96); } 4%, 33% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; } }
  :global(.card.is-playing) .rig--desktop { transform-origin: 63% 46%; animation: zoom-d 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes zoom-d { 0%, 18% { transform: none; } 24%, 30% { transform: scale(1.75); } 33%, 100% { transform: scale(1.75); } }

  /* tablet: zoom into the order summary, dishes drop in one by one */
  :global(.card.is-playing) .rig--tablet { transform-origin: 20% 55%; animation: zoom-t 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes zoom-t { 0%, 38% { transform: none; } 43%, 63% { transform: scale(1.45); } 66%, 100% { transform: scale(1.45); } }
  :global(.card.is-playing) .tt { animation: build-t 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .45s); }
  @keyframes build-t { 0%, 43% { opacity: 0; transform: translateY(-18%) scale(.97); } 46%, 66% { opacity: 1; transform: none; } 67%, 100% { opacity: 0; } }

  /* phone: table rows slide in, then the swipe on the first row with a zoom */
  :global(.card.is-playing) .tp { animation: build-p 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .12s); }
  @keyframes build-p { 0%, 69% { opacity: 0; transform: translateX(12%); } 72%, 99% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  :global(.card.is-playing) .swipe { animation: swipe 14s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes swipe { 0%, 82% { opacity: 0; transform: translateX(8%); } 85%, 99% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  :global(.card.is-playing) .rig--phone { transform-origin: 50% 24%; animation: zoom-p 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes zoom-p { 0%, 80% { transform: none; } 86%, 97% { transform: scale(1.5); } 100% { transform: scale(1.5); } }

  @media (prefers-reduced-motion: reduce) { .motion { display: none; } }
</style>

<script>
  // Play on hover (restarting from the first scene); on touch screens, play while the card is mostly in view.
  const cards = document.querySelectorAll<HTMLElement>('.card:has(.motion--cover)');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (matchMedia('(hover: hover)').matches) {
      cards.forEach((c) => {
        const on = () => c.classList.add('is-playing');
        const off = () => c.classList.remove('is-playing');
        c.addEventListener('mouseenter', on); c.addEventListener('mouseleave', off);
        c.addEventListener('focusin', on); c.addEventListener('focusout', off);
      });
    } else {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-playing', e.isIntersecting)), { threshold: 0.6 });
      cards.forEach((c) => io.observe(c));
    }
  }
</script>
