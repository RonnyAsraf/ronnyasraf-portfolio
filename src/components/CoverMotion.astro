---
/**
 * Animated card preview for Cover, generated by gen/cover_motion.py from the Figma screens.
 * Three scenes, one device at a time: the dashboard builds itself and zooms into the AI card,
 * the tablet's restaurant map fills with tables and zooms into a long press on table 1, the phone fills its table list and shows the swipe.
 * Built from transparent image layers (not video) so the card's hover colour shows through.
 */
---
<div class="motion motion--cover" aria-hidden="true">
  <div class="rig rig--desktop"><div class="dev dev--desktop">
    <div class="cam">
      <img class="base" src="/images/case-studies/cover/motion/d-base.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:85.417%;top:0.000%;width:14.583%;height:100.000%;--i:0" src="/images/case-studies/cover/motion/d-side.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:2.083%;top:10.370%;width:81.250%;height:6.111%;--i:1" src="/images/case-studies/cover/motion/d-head.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:56.823%;top:17.685%;width:26.510%;height:10.278%;--i:2" src="/images/case-studies/cover/motion/d-k1.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:29.427%;top:17.685%;width:26.510%;height:10.278%;--i:3" src="/images/case-studies/cover/motion/d-k2.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:2.083%;top:17.685%;width:26.510%;height:10.278%;--i:4" src="/images/case-studies/cover/motion/d-k3.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:43.125%;top:30.185%;width:40.208%;height:32.593%;--i:5" src="/images/case-studies/cover/motion/d-ai.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:2.083%;top:30.185%;width:40.208%;height:46.574%;--i:6" src="/images/case-studies/cover/motion/d-pop.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:43.125%;top:64.259%;width:40.208%;height:12.500%;--i:7" src="/images/case-studies/cover/motion/d-st.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:56.823%;top:79.074%;width:26.510%;height:17.593%;--i:8" src="/images/case-studies/cover/motion/d-c1.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:29.427%;top:79.074%;width:26.510%;height:17.593%;--i:9" src="/images/case-studies/cover/motion/d-c2.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile td" style="left:2.083%;top:79.074%;width:26.510%;height:17.593%;--i:10" src="/images/case-studies/cover/motion/d-c3.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
    </div>
  </div></div>
  <div class="rig rig--tablet"><div class="dev dev--tablet">
    <div class="cam">
      <img class="base" src="/images/case-studies/cover/motion/t-base.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:79.616%;top:14.322%;width:15.108%;height:10.804%;--i:0" src="/images/case-studies/cover/motion/t-t1.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:61.631%;top:14.322%;width:15.108%;height:10.804%;--i:1" src="/images/case-studies/cover/motion/t-t2.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:43.645%;top:14.322%;width:15.108%;height:10.804%;--i:2" src="/images/case-studies/cover/motion/t-t3.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:55.396%;top:27.471%;width:39.329%;height:10.720%;--i:3" src="/images/case-studies/cover/motion/t-t4.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:55.396%;top:39.196%;width:39.329%;height:10.720%;--i:4" src="/images/case-studies/cover/motion/t-t5.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:7.194%;top:14.070%;width:18.585%;height:33.920%;--i:5" src="/images/case-studies/cover/motion/t-bar.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:71.942%;top:52.596%;width:22.662%;height:10.804%;--i:6" src="/images/case-studies/cover/motion/t-t6.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:50.360%;top:52.596%;width:15.108%;height:10.804%;--i:7" src="/images/case-studies/cover/motion/t-t7.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:28.777%;top:52.596%;width:15.108%;height:10.804%;--i:8" src="/images/case-studies/cover/motion/t-t8.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tt" style="left:7.194%;top:52.596%;width:15.108%;height:10.804%;--i:9" src="/images/case-studies/cover/motion/t-t9.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <span class="tap"></span>
    </div>
  </div></div>
  <div class="rig rig--phone"><div class="dev dev--phone">
    <div class="cam">
      <img class="base" src="/images/case-studies/cover/motion/p-base.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:20.261%;width:89.744%;height:8.412%;--i:0" src="/images/case-studies/cover/motion/p-r0.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:29.621%;width:89.744%;height:8.412%;--i:1" src="/images/case-studies/cover/motion/p-r1.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:38.981%;width:89.744%;height:8.412%;--i:2" src="/images/case-studies/cover/motion/p-r2.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:48.341%;width:89.744%;height:8.412%;--i:3" src="/images/case-studies/cover/motion/p-r3.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:57.701%;width:89.744%;height:8.412%;--i:4" src="/images/case-studies/cover/motion/p-r4.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:67.062%;width:89.744%;height:8.412%;--i:5" src="/images/case-studies/cover/motion/p-r5.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:76.422%;width:89.744%;height:8.412%;--i:6" src="/images/case-studies/cover/motion/p-r6.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:85.782%;width:89.744%;height:8.412%;--i:7" src="/images/case-studies/cover/motion/p-r7.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile tp" style="left:5.128%;top:95.142%;width:89.744%;height:8.412%;--i:8" src="/images/case-studies/cover/motion/p-r8.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
      <img class="tile swipe" style="left:0%;top:19.550%;width:100%;height:17.180%" src="/images/case-studies/cover/motion/p-swipe.webp?v=be4ec637" alt="" loading="lazy" decoding="async" />
    </div>
  </div></div>
</div>

<style>
  /* Sizes in cqw (percent of the card width) so the scene scales with the card. Card is 905:620 = 100cqw x 68.5cqw. */
  .motion { position: absolute; inset: 0; container-type: inline-size; pointer-events: none; opacity: 0; transition: opacity .35s ease; }
  .rig { position: absolute; }
  .dev {
    position: absolute; inset: 0; overflow: hidden; background: #fff; opacity: 0;
    border: .45cqw solid rgba(255, 255, 255, .75); background-clip: padding-box;
    box-shadow: 2.1cqw 1.7cqw 4.7cqw rgba(112, 144, 176, .2);
  }
  .rig--desktop { left: 8cqw; top: 10.6cqw; width: 84cqw; aspect-ratio: 16 / 9; } .dev--desktop { border-radius: 1.3cqw; }
  .rig--tablet { left: 29.75cqw; top: 5cqw; width: 40.5cqw; aspect-ratio: 834 / 1194; } .dev--tablet { border-radius: 2.6cqw; }
  .rig--phone { left: 36.1cqw; top: 4.2cqw; width: 27.8cqw; aspect-ratio: 390 / 844; } .dev--phone { border-radius: 4cqw; }
  .cam { position: absolute; inset: 0; }
  .base, .tile { position: absolute; display: block; }
  .base { inset: 0; width: 100%; height: 100%; }
  .tile { opacity: 0; }

  :global(.card.is-playing) .motion { opacity: 1; }
  :global(.card.is-playing .card-static) { opacity: 0; }

  /* ---- scene timing (14s loop): desktop 0-33%, tablet 33-66%, phone 66-100% ---- */
  :global(.card.is-playing) .dev--desktop { animation: cv-sc-d 14s cubic-bezier(.2,.7,.2,1) infinite; }
  :global(.card.is-playing) .dev--tablet  { animation: cv-sc-t 14s cubic-bezier(.2,.7,.2,1) infinite; }
  :global(.card.is-playing) .dev--phone   { animation: cv-sc-p 14s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes cv-sc-d { 0% { opacity: 0; transform: translateY(3cqw) scale(.96); } 4%, 30% { opacity: 1; transform: none; } 33%, 100% { opacity: 0; transform: scale(1.02); } }
  @keyframes cv-sc-t { 0%, 33% { opacity: 0; transform: translateY(4cqw) scale(.96); } 37%, 63% { opacity: 1; transform: none; } 66%, 100% { opacity: 0; transform: scale(1.02); } }
  @keyframes cv-sc-p { 0%, 66% { opacity: 0; transform: translateY(4cqw) scale(.96); } 70%, 97% { opacity: 1; transform: none; } 100% { opacity: 0; transform: scale(1.02); } }

  /* desktop: parts pop in one by one, then the whole device (frame included) zooms into the AI recommendations card */
  :global(.card.is-playing) .td { animation: cv-build-d 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(.35s + var(--i) * .16s); }
  @keyframes cv-build-d { 0% { opacity: 0; transform: translateY(14%) scale(.96); } 4%, 33% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; } }
  :global(.card.is-playing) .rig--desktop { transform-origin: 63% 46%; animation: cv-zoom-d 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes cv-zoom-d { 0%, 18% { transform: none; } 24%, 30% { transform: scale(1.75); } 33%, 100% { transform: scale(1.75); } }

  /* tablet: the restaurant map fills with tables one by one, zooms into tables 1-2, long press on table 1 */
  :global(.card.is-playing) .rig--tablet { transform-origin: 76% 20%; animation: cv-zoom-t 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes cv-zoom-t { 0%, 48% { transform: none; } 54%, 63% { transform: scale(1.6); } 66%, 100% { transform: scale(1.6); } }
  :global(.card.is-playing) .tt { animation: cv-build-t 14s cubic-bezier(.34,1.4,.5,1) infinite; animation-delay: calc(var(--i) * .16s); }
  @keyframes cv-build-t { 0%, 36% { opacity: 0; transform: scale(.6); } 39%, 66% { opacity: 1; transform: none; } 67%, 100% { opacity: 0; } }
  .tap { position: absolute; left: 87.2%; top: 19.7%; width: 18%; aspect-ratio: 1; border-radius: 50%; background: rgba(108, 92, 255, .25); border: .4cqw solid rgba(255,255,255,.9); transform: translate(-50%, -50%) scale(0); opacity: 0; }
  :global(.card.is-playing) .tap { animation: cv-tap-t 14s ease-out infinite; }
  @keyframes cv-tap-t { 0%, 56% { opacity: 0; transform: translate(-50%, -50%) scale(.3); } 57% { opacity: 1; transform: translate(-50%, -50%) scale(.5); } 61% { opacity: .8; transform: translate(-50%, -50%) scale(.9); } 64%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.3); } }

  /* phone: table rows slide in, then the swipe on the first row with a zoom */
  :global(.card.is-playing) .tp { animation: cv-build-p 14s cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * .12s); }
  @keyframes cv-build-p { 0%, 69% { opacity: 0; transform: translateX(12%); } 72%, 99% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  :global(.card.is-playing) .swipe { animation: cv-swipe 14s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes cv-swipe { 0%, 82% { opacity: 0; transform: translateX(8%); } 85%, 99% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  :global(.card.is-playing) .rig--phone { transform-origin: 50% 24%; animation: cv-zoom-p 14s cubic-bezier(.45,0,.2,1) infinite; }
  @keyframes cv-zoom-p { 0%, 80% { transform: none; } 86%, 97% { transform: scale(1.5); } 100% { transform: scale(1.5); } }

  @media (prefers-reduced-motion: reduce) { .motion { display: none; } }
</style>

<script>
  // Play on hover (restarting from the first scene); on touch screens, play while the card is mostly in view.
  const cards = document.querySelectorAll<HTMLElement>('.card:has(.motion--cover)');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (matchMedia('(hover: hover)').matches) {
      cards.forEach((c) => {
        const on = () => c.classList.add('is-playing');
        const off = () => c.classList.remove('is-playing');
        c.addEventListener('mouseenter', on); c.addEventListener('mouseleave', off);
        c.addEventListener('focusin', on); c.addEventListener('focusout', off);
      });
    }
  }
</script>
