---
import { findImage } from '../lib/img';
import { cardColors } from '../data/cardColors';
import CoverMotion from './CoverMotion.astro';
import MoneyMapMotion from './MoneyMapMotion.astro';
import VeloraMotion from './VeloraMotion.astro';
import TimelinesMotion from './TimelinesMotion.astro';
import CardMotion from './CardMotion.astro';
import { allSites } from '../data/projects';

interface Props {
  image: string; // card image base path, e.g. images/cards/case-studies/cover
  name: string;
  tags: string;
  year: string;
  href?: string; // internal page
  url?: string; // external live site
  featured?: boolean; // wide 905:620 image, used for the case studies on the home page
  motion?: 'cover' | 'the-money-map' | 'velora' | 'timelines'; // animated preview that plays on hover
}
const { image, name, tags, year, href, url, featured = false, motion } = Astro.props;
const img = findImage(image);
const tint = cardColors[image];
const primary = href ?? url;
const external = !href && !!url;
// Archived websites: "View project" opens the full screen recording in an overlay instead of a page.
const archived = image.startsWith('images/cards/websites/') ? allSites.find((s) => s.archived && `images/cards/websites/${s.slug}` === image) : undefined;
const lb = archived ? { 'data-lightbox': `/videos/websites/${archived.slug}`, 'data-lightbox-title': archived.name } : {};
---
<article class:list={["card", { "card--featured": featured }]}>
  <a {...lb} class="card__media" style={tint ? `--tint:${tint}` : undefined} href={primary} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} tabindex="-1" aria-hidden="true">
    {img
      ? <img class="card-static" src={img} alt="" loading="lazy" decoding="async" width={featured ? 905 : 590} height={featured ? 620 : 508} />
      : <span class="card__placeholder">{name}</span>}
    {motion === 'cover' && <CoverMotion />}
    {motion === 'the-money-map' && <MoneyMapMotion />}
    {motion === 'velora' && <VeloraMotion />}
    {motion === 'timelines' && <TimelinesMotion />}
    {!motion && <CardMotion image={image} />}
  </a>
  <div class="card__info">
    <div class="card__meta meta"><span>{tags}</span><span>{year}</span></div>
    <h3 class="card__title"><a {...lb} href={primary} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{name}</a></h3>
    <div class="card__links meta">
      {href && <a {...lb} class="link-underline" href={href}>View project</a>}
      {url && <a class="link-underline" href={url} target="_blank" rel="noopener">Visit site<span class="sr-only"> (opens in a new tab)</span></a>}
    </div>
  </div>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .card__media {
    position: relative;
    display: grid; place-items: center; aspect-ratio: 590 / 508; overflow: hidden; border-radius: var(--radius-panel);
    background: var(--card);
    transition: background-color .45s ease;
  }
  .card--featured .card__media { aspect-ratio: 905 / 620; }
  .card:hover .card__media, .card:focus-within .card__media { background: var(--tint, var(--card)); }
  .card__media > img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1), opacity .35s ease; }
  .card:hover .card__media > img { transform: scale(1.03); }
  .card__placeholder { font-size: var(--fs-label); color: var(--muted); }
  .card__info { display: flex; flex-direction: column; gap: 8px; }
  .card__meta { display: flex; justify-content: space-between; gap: 16px; }
  .card__title { font-size: var(--fs-card-title); font-weight: 400; line-height: 1.4; }
  .card__links { display: flex; justify-content: space-between; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
