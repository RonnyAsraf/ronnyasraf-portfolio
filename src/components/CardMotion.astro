---
/**
 * Hover animation for a regular project card, generated by scripts/card_motion.py.
 * Images use data-src and only load the first time the card plays, so the page stays light.
 */
import { cardMotions } from '../data/cardMotions';
interface Props { image: string }
const m = cardMotions[Astro.props.image];
---
{m && (
  <>
    <Fragment set:html={m.html} />
    <style is:global set:html={m.css}></style>
  </>
)}

<style is:global>
  .cm { position: absolute; inset: 0; container-type: inline-size; pointer-events: none; opacity: 0; transition: opacity .35s ease; }
  .card.is-playing .cm { opacity: 1; }
  .card.is-playing .card-static { opacity: 0; }
  .cm .rig { position: absolute; }
  .cm .dev {
    position: absolute; inset: 0; overflow: hidden; background: #fff;
    border: .45cqw solid rgba(255, 255, 255, .75); background-clip: padding-box;
    box-shadow: 2.1cqw 1.7cqw 4.7cqw rgba(112, 144, 176, .2);
  }
  .cm .dev--browser { border-radius: 1.3cqw; }
  .cm .dev--phone { border-radius: 4.4cqw; }
  .cm .bar { position: absolute; left: 0; right: 0; top: 0; height: 3.2cqw; background: #f4f4f4; display: flex; align-items: center; gap: .6cqw; padding-left: 1.4cqw; }
  .cm .bar i { width: .9cqw; height: .9cqw; border-radius: 50%; background: #d9d9d9; }
  .cm .scr { position: absolute; left: 0; right: 0; bottom: 0; top: 0; overflow: hidden; }
  .cm .scene { position: absolute; inset: 0; opacity: 0; }
  .cm .scene:first-child { opacity: 1; }
  .cm .band { position: absolute; left: 0; width: 100%; display: block; opacity: 0; }
  .cm .pg { position: absolute; left: 0; top: 0; width: 100%; height: auto; display: block; }
  .cm .cur { position: absolute; width: 2.6cqw; height: 2.6cqw; left: 80%; top: 80%; opacity: 0; filter: drop-shadow(0 .2cqw .4cqw rgba(0,0,0,.25)); }
  .cm .tap { position: absolute; width: 5cqw; aspect-ratio: 1; border-radius: 50%; background: rgba(14, 14, 14, .16); border: .25cqw solid rgba(255,255,255,.9); opacity: 0; transform: translate(-50%, -50%); }
  @keyframes cm-dev { 0% { opacity: 0; transform: translateY(4cqw) scale(.95); } 4%, 96% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  .card.is-paused .card__media * { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) { .cm { display: none; } }
</style>

<script>
  // Play on hover (loading the images the first time); on touch screens, play while the card is mostly in view.
  const cards = document.querySelectorAll<HTMLElement>('.card:has(.cm)');
  const play = (c: HTMLElement, on: boolean) => {
    const m = c.querySelector<HTMLElement>('.cm');
    if (!m) return;
    if (on) m.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((i) => { i.src = i.dataset.src!; i.removeAttribute('data-src'); });
    c.classList.toggle('is-playing', on);
    m.classList.toggle('is-on', on);
  };
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (matchMedia('(hover: hover)').matches) {
      cards.forEach((c) => {
        c.addEventListener('mouseenter', () => play(c, true)); c.addEventListener('mouseleave', () => play(c, false));
        c.addEventListener('focusin', () => play(c, true)); c.addEventListener('focusout', () => play(c, false));
      });
    } else {
      // Touch screens: every animated card shows its animation instead of the static image.
      // It plays while on screen and pauses off screen; images load shortly before the card arrives.
      const all = document.querySelectorAll<HTMLElement>('.card:has(.cm, .motion)');
      const load = (c: HTMLElement) => c.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((i) => { i.src = i.dataset.src!; i.removeAttribute('data-src'); });
      const near = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { load(e.target as HTMLElement); near.unobserve(e.target); } }), { rootMargin: '100% 100%' });
      const vis = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-paused', !e.isIntersecting)), { threshold: 0 });
      all.forEach((c) => {
        c.classList.add('is-playing', 'is-paused');
        c.querySelector('.cm')?.classList.add('is-on');
        near.observe(c); vis.observe(c);
      });
    }
  }
</script>
