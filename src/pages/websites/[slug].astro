---
import ProjectPage from '../../components/ProjectPage.astro';
import { websiteProjects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return websiteProjects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props as { project: Project };
---
<ProjectPage project={project} dir={`images/websites/${project.slug}`} kind="websites" />
