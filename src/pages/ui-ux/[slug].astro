---
import ProjectPage from '../../components/ProjectPage.astro';
import { uxuiProjects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return uxuiProjects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props as { project: Project };
---
<ProjectPage project={project} dir={`images/ui-ux/${project.slug}`} kind="ui-ux" />
